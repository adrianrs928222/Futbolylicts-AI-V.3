# FUTBOLYLICTS-AI v0.23
# API-Football = datos de fútbol (obligatoria para modo live)
API_FOOTBALL_KEY=
API_FOOTBALL_BASE_URL=https://v3.football.api-sports.io
API_CALL_BUDGET_DAILY=90
MAX_FIXTURES_TO_ENRICH=40
GLOBAL_DAY_DEEP_SCAN_FIXTURES=40
GLOBAL_DAY_MAX_PER_LEAGUE=8
GLOBAL_DAY_STANDING_LEAGUES=6
ENABLE_STANDINGS=true

# The Odds API = opcional en v0.23.
# Se conserva por compatibilidad/futura calibración, pero el motor EST. no la necesita.
THE_ODDS_API_KEY=
THE_ODDS_API_BASE_URL=https://api.the-odds-api.com/v4
THE_ODDS_BOOKMAKERS=bet365
PREFERRED_BOOKMAKER=Bet365
THE_ODDS_API_DAILY_CREDIT_BUDGET=14
THE_ODDS_MAX_FIXTURES_TO_PRICE=12
THE_ODDS_MAX_MARKETS_PER_FIXTURE=1
THE_ODDS_SECOND_PASS_FIXTURES=2

# Caché
CACHE_FIXTURES_TTL_SECONDS=21600
CACHE_TEAM_FORM_TTL_SECONDS=21600
CACHE_STANDINGS_TTL_SECONDS=21600
CACHE_ODDS_TTL_SECONDS=600
CACHE_ANALYSIS_TTL_SECONDS=300
CACHE_STALE_FALLBACK_SECONDS=86400
THE_ODDS_SPORTS_TTL_SECONDS=86400
THE_ODDS_EVENTS_TTL_SECONDS=3600

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Demo fallback: mejor false en producción para no confundir demo con datos reales
ENABLE_DEMO_FALLBACK=false

# Machine Learning sidecar (v0.25) — no modifica lib/engine/*
ML_CRON_SECRET=
APP_BASE_URL=https://TU-SERVICIO.onrender.com
ML_MIN_SAMPLES=100
ML_BOOTSTRAP_DAYS=14
ML_MAX_FIXTURES_PER_RUN=30
ML_MAX_TRAINING_ROWS=10000
