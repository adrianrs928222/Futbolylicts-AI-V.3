# ==============================
# FUTBOLYLICTS-AI v0.14
# ==============================

# ------------------------------------------------
# API-FOOTBALL = SOLO DATOS DE FÚTBOL
# ------------------------------------------------
API_FOOTBALL_KEY=
API_FOOTBALL_BASE_URL=https://v3.football.api-sports.io

# Dejamos margen frente al límite del proveedor.
API_CALL_BUDGET_DAILY=90

# v0.12: todos visibles, 18 análisis profundos por defecto.
MAX_FIXTURES_TO_ENRICH=18
ENABLE_STANDINGS=true

# ------------------------------------------------
# THE ODDS API = SOLO CUOTAS
# ------------------------------------------------
THE_ODDS_API_KEY=
THE_ODDS_API_BASE_URL=https://api.the-odds-api.com/v4

# Bet365 es la casa solicitada. The Odds API usa la key de bookmaker "bet365".
THE_ODDS_BOOKMAKERS=bet365
# Compatibilidad con la variable que ya tienes en Render:
PREFERRED_BOOKMAKER=Bet365

# Presupuesto de SEGURIDAD nuestro. Con 14/día el consumo máximo teórico
# ronda 420 créditos en 30 días. Ajusta si tu plan cambia.
THE_ODDS_API_DAILY_CREDIT_BUDGET=14

# Solo se ponen cuotas a los mejores partidos según estadísticas.
THE_ODDS_MAX_FIXTURES_TO_PRICE=10

# Una familia inicial por partido: reparte mejor los créditos entre más encuentros.
THE_ODDS_MAX_MARKETS_PER_FIXTURE=1

# Usa los créditos restantes en una segunda familia para hasta 4 partidos sin pick.
THE_ODDS_SECOND_PASS_FIXTURES=4

# ------------------------------------------------
# CACHÉ
# ------------------------------------------------
CACHE_FIXTURES_TTL_SECONDS=600
CACHE_TEAM_FORM_TTL_SECONDS=21600
CACHE_STANDINGS_TTL_SECONDS=7200
CACHE_ODDS_TTL_SECONDS=600
CACHE_ANALYSIS_TTL_SECONDS=300
CACHE_STALE_FALLBACK_SECONDS=86400

# Listado de deportes de The Odds API: 24h (endpoint sin coste de cuota)
THE_ODDS_SPORTS_TTL_SECONDS=86400

# Eventos de The Odds API: 30 min (endpoint sin coste de cuota)
THE_ODDS_EVENTS_TTL_SECONDS=1800

# ------------------------------------------------
# SUPABASE = CACHÉ + HISTÓRICO + CONTADORES
# ------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# La service role SOLO va en servidor. Nunca NEXT_PUBLIC_ y nunca en GitHub.

# Si API-Football falla, permite enseñar demo.
ENABLE_DEMO_FALLBACK=true
